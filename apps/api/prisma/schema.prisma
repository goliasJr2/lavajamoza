generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ADMIN
  STAFF
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         StaffRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Service {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String
  priceMzn        Int
  durationMinutes Int
  isActive        Boolean  @default(true)
  isDemo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings        Booking[]

  @@index([isActive, name])
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vehicles  Vehicle[]
  bookings  Booking[]
  demoWallet DemoWallet?
  demoMovements DemoMovement[]
  notifications CustomerNotification[]
}

model Vehicle {
  id         String    @id @default(cuid())
  plate      String    @unique
  customerId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bookings   Booking[]
}

model Booking {
  id                 String        @id @default(cuid())
  publicCode         String        @unique
  customerId         String
  vehicleId          String
  serviceId          String
  status             BookingStatus @default(REQUESTED)
  startsAt           DateTime
  endsAt             DateTime
  priceMznAtBooking  Int
  durationAtBooking  Int
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle            Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  service            Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  demoMovements      DemoMovement[]
  notifications      CustomerNotification[]

  @@index([startsAt, endsAt, status])
  @@index([customerId, createdAt])
}

model DemoWallet {
  id            String   @id @default(cuid())
  customerId    String   @unique
  balanceMzn    Int      @default(0)
  pointsBalance Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  movements DemoMovement[]
}

enum DemoMovementType {
  LOAD
  PAYMENT
  POINTS_EARNED
  POINTS_REDEEMED
}

model DemoMovement {
  id             String           @id @default(cuid())
  walletId       String
  customerId     String
  bookingId      String?
  type           DemoMovementType
  amount         Int
  description    String
  idempotencyKey String           @unique
  createdAt      DateTime         @default(now())

  wallet  DemoWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  booking Booking?   @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@unique([bookingId, type])
}

enum LocalPlaceCategory {
  SHOPS
  FOOD
  ENTERTAINMENT
}

model LocalPlace {
  id               String            @id @default(cuid())
  name             String            @unique
  category         LocalPlaceCategory
  description      String
  estimatedMinutes Int
  isDemo           Boolean           @default(true)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([isActive, category])
}

model CustomerNotification {
  id         String   @id @default(cuid())
  customerId String
  bookingId  String?
  title      String
  message    String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([customerId, readAt])
}
