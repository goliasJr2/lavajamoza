# Valores locais de desenvolvimento. Não reutilizar estas credenciais em produção.
POSTGRES_DB=lavaja
POSTGRES_USER=lavaja
POSTGRES_PASSWORD=lavaja_local
POSTGRES_PORT=5433

# Ligação local usada pelo backend NestJS e pelo Prisma.
DATABASE_URL=postgresql://lavaja:lavaja_local@localhost:5433/lavaja?schema=public

# API e conta administrativa local de demonstração
API_PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-this-local-secret-to-a-long-random-value
ADMIN_EMAIL=admin@lavaja.local
ADMIN_PASSWORD=change-this-password-123

# URL acessível pelo browser para o frontend consumir a API
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
